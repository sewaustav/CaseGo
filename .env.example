# Copy this file to .env and fill in real values
# Root .env is used by Docker Compose for ${VAR} interpolation

# ── Profile DB ───────────────────────────────────────────
PROFILE_DB_USER=dev_user
PROFILE_DB_PASSWORD=change_me
PROFILE_DB_NAME=app_db

# ── CaseGo DB ────────────────────────────────────────────
CASEGO_DB_USER=casego_user
CASEGO_DB_PASSWORD=change_me
CASEGO_DB_NAME=casego_db

# ── CaseProfile DB ───────────────────────────────────────
CASEPROFILE_DB_USER=caseprofile_user
CASEPROFILE_DB_PASSWORD=change_me
CASEPROFILE_DB_NAME=caseprofile_db

# ── Payment DB ───────────────────────────────────────────
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=change_me
PAYMENT_DB_NAME=payment_db

# ── CaseGo Redis ─────────────────────────────────────────
CASEGO_REDIS_PASSWORD=change_me

# ── Build args ───────────────────────────────────────────
GITHUB_TOKEN=

# ── Auth service ─────────────────────────────────────────
API_PORT=8000
API_PORT_FORWARD=8000
